rules_version = '2';

// Kök — deny by default. Clients may write only their own profile (shape-checked, no money or
// entitlement fields) and their device registrations. Wallets, gifts, consent, entitlements,
// previews, ledgers, idempotency records, cohort membership, reports and config are written
// exclusively by Cloud Functions (Admin SDK, which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid}: the only client-writable profile fields.
    function isValidProfile(data) {
      return data.keys().hasOnly(['locale', 'goal', 'stage', 'onboardingVariant', 'createdAt'])
        && (!('locale' in data)
            || (data.locale is string && data.locale.size() > 0 && data.locale.size() <= 35))
        && (!('goal' in data)
            || data.goal == null
            || data.goal in ['hairline', 'crown', 'part', 'brows', 'beard'])
        && (!('stage' in data)
            || data.stage == null
            || data.stage in ['researching', 'planned', 'done'])
        && (!('onboardingVariant' in data)
            || (data.onboardingVariant is string && data.onboardingVariant.size() <= 40));
    }

    // createdAt is the server time (serverTimestamp()) on first write and never changes.
    function isValidCreatedAtOnCreate(data) {
      return !('createdAt' in data) || data.createdAt == request.time;
    }

    function isValidCreatedAtOnUpdate(data, existing) {
      return !('createdAt' in data)
        || ('createdAt' in existing && data.createdAt == existing.createdAt)
        || (!('createdAt' in existing) && data.createdAt == request.time);
    }

    // users/{uid}/devices/{deviceId}: push registration written by the app.
    function isValidDevice(data) {
      return data.keys().hasAll(['token', 'platform', 'updatedAt'])
        && data.keys().hasOnly(['token', 'platform', 'topics', 'locale', 'updatedAt'])
        && data.token is string && data.token.size() > 0 && data.token.size() <= 4096
        && data.platform in ['ios', 'android', 'web']
        && (!('topics' in data)
            || (data.topics is list && data.topics.size() <= 10
                && data.topics.hasOnly(['previews', 'offers', 'reminders'])))
        && (!('locale' in data) || (data.locale is string && data.locale.size() <= 16))
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidProfile(request.resource.data)
        && isValidCreatedAtOnCreate(request.resource.data);
      allow update: if isOwner(uid)
        && isValidProfile(request.resource.data)
        && isValidCreatedAtOnUpdate(request.resource.data, resource.data);

      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && deviceId.size() <= 128
          && isValidDevice(request.resource.data);
      }

      // Server-written, owner-readable. No client write rules exist.
      match /previews/{previewId} {
        allow read: if isOwner(uid);
      }
      match /private/{docId} {
        allow get: if isOwner(uid) && docId in ['wallet', 'gift', 'entitlement', 'consent'];
      }
      match /ledger/{entryId} {
        allow read: if isOwner(uid);
      }

      // requests/*, previews_private/*, rc_events/*: no client access at all.
    }

    // cohortMembers/*, reports/*, config/*: server-only. Everything else denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
