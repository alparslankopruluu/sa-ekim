    "doctor": "expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm run lint:translations && npm test -- --ci",
    "assets:icons": "node scripts/render-brand-assets.mjs",
    "gen:i18n": "node scripts/gen-translations.mjs",
    "lint:translations:partial": "node scripts/gen-translations.mjs --check && node scripts/check-translations.mjs --allow-missing"
