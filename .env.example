# Copy to .env.local (gitignored). Only PUBLIC values may live in EXPO_PUBLIC_* (security S2).
# mock = no keys, everything simulated · emulator = Firebase Local Emulator Suite · live = real project
EXPO_PUBLIC_BACKEND_MODE=mock

# RevenueCat public SDK keys (client-safe) — created in phase C
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

EXPO_PUBLIC_PRIVACY_URL=https://kok-prod.web.app/privacy/
EXPO_PUBLIC_TERMS_URL=https://kok-prod.web.app/terms/
EXPO_PUBLIC_SUPPORT_EMAIL=

# Debug-only App Check token (dev builds)
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Build identity
KOK_BUNDLE_ID=com.techtactoe.kok
EAS_PROJECT_ID=

# Optional overrides for the native Firebase files (gitignored):
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
# GOOGLE_SERVICES_JSON=./google-services.json

# Play upload signing (passed as Gradle properties by the build; never committed):
# ORG_GRADLE_PROJECT_KOK_UPLOAD_STORE_FILE=
# ORG_GRADLE_PROJECT_KOK_UPLOAD_PASSWORD=
# ORG_GRADLE_PROJECT_KOK_UPLOAD_KEY_ALIAS=

# Functions secrets live in Secret Manager, NOT here: FAL_KEY, FAL_WEBHOOK_TOKEN_SALT, REVENUECAT_WEBHOOK_AUTH
