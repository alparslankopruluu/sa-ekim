# Functions EMULATOR ONLY. Copy to functions/.secret.local (gitignored) and fill
# with development values. Deployed functions read Google Secret Manager instead:
#   firebase functions:secrets:set FAL_KEY --project belto-dev
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_AUTH --project belto-dev
#   firebase functions:secrets:set FAL_WEBHOOK_TOKEN_SALT --project belto-dev
# Never paste real values into chat, docs, or committed files.

# fal.ai API key (server-side only).
FAL_KEY=replace-with-a-dev-fal-key

# The exact value configured in RevenueCat as the webhook Authorization header,
# pasted verbatim into the dashboard (an optional "Bearer " prefix is accepted too).
REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-string

# HMAC salt for per-render fal webhook tokens (e.g. `openssl rand -base64 48`).
FAL_WEBHOOK_TOKEN_SALT=replace-with-a-long-random-string
