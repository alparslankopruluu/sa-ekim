rules_version = '2';

// Kök — deny by default. Clients upload only their own selfie for a preview; results are written
// by Cloud Functions and readable by their owner. Selfies and results are deleted after 30 days
// by hourlyMaintenance (and immediately by deletePreview / deleteAccount).
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Selfie for one preview: create only (no overwrite, so a running preview cannot be swapped),
    // a plain file name, an image type, at most 10 MB. HEIC is accepted by the rule but the server
    // decodes only JPEG/PNG, so the app converts to JPEG before upload.
    match /uploads/{uid}/{file} {
      allow get, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && resource == null
        && file.matches('[A-Za-z0-9_-]{1,100}[.](jpg|jpeg|png|heic)')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Preview results: server-written only, owner-readable.
    match /users/{uid}/previews/{file} {
      allow get: if isOwner(uid);
    }
  }
}
