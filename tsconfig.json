{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./functions/src/shared/*"
      ],
      "@assets/*": [
        "./assets/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "jest.setup.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "functions/node_modules",
    "functions/lib",
    "templates",
    "scripts",
    "dist-web",
    "docs"
  ]
}
